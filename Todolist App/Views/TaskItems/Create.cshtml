<style>
    .form-card {
        transform: translateY(-40px);
    }
</style>

@model Todolist_App.Models.TaskItem

@{
    ViewData["Title"] = "New Task";
}

<div class="form-page">
    <div class="form-card">
        <h2>New Task</h2>
        <p class="subtext">What do you need to get done?</p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="text-input" placeholder="e.g. Buy groceries" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-check-row">
                <input asp-for="IsDone" class="check-input" />
                <label asp-for="IsDone" class="check-label">Already done</label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">Add Task</button>
                <a asp-action="Index" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>