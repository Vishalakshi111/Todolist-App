@model Todolist_App.Models.TaskItem

@{
    ViewData["Title"] = "Delete Task";
}

<div class="form-page">
    <div class="form-card">
        <h2>Delete Task</h2>
        <p class="subtext">Are you sure you want to delete this task?</p>

        <div class="form-group">
            <label class="form-label">Title</label>
            <div class="text-input" style="background:#f4f4f8;">@Model.Title</div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <button type="submit" class="btn-save" style="background:#e74c3c;">Delete</button>
                <a asp-action="Index" class="btn-cancel">Cancel</a>
            </div>
        </form>
    </div>
</div>