<style>
    .app-title-bar {
        margin-top: 30px !important;
    }
</style>
@model IEnumerable<Todolist_App.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
    var total = Model.Count();
    var done = Model.Count(t => t.IsDone);
    var pending = total - done;
}

<div class="app-layout">
    <div class="sidebar">
        <h3>Hi there 👋</h3>
        <p class="subtext">Welcome back to your workspace, we missed you!</p>

        <input type="text" id="searchBox" class="search-box" placeholder="🔍 Search Task..." />

        <p class="overview-label">OVERVIEW</p>
        <div class="stat-grid">
            <div class="stat-tile stat-purple" id="filterTotal" onclick="filterTasks('all')">
                <span class="stat-num">@total</span>
                <span class="stat-label">Total</span>
            </div>
            <div class="stat-tile stat-teal" id="filterDone" onclick="filterTasks('done')">
                <span class="stat-num">@done</span>
                <span class="stat-label">Done</span>
            </div>
        </div>
        <div class="stat-tile stat-orange full-width" id="filterPending" onclick="filterTasks('pending')">
            <span class="stat-num">@pending</span>
            <span class="stat-label">Pending</span>
        </div>
    </div>

    <div class="main-content">
        <div class="task-card">
            <div class="task-header">
                <div>
                    <h2>My Tasks</h2>
                    <p class="subtext">Stay on top of what matters today.</p>
                </div>
                <a asp-action="Create" class="add-btn">+</a>
            </div>

            <p class="section-label" id="sectionLabel">PENDING</p>
            <div class="task-list" id="taskList">
                @foreach (var item in Model)
                {
                    <div class="task-row" data-title="@item.Title.ToLower()" data-status="@(item.IsDone ? "done" : "pending")">
                        <div class="task-left">
                            <form asp-action="ToggleDone" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="circle-btn @(item.IsDone ? "circle-done" : "")"></button>
                            </form>
                            <span class="task-title @(item.IsDone ? "done" : "")">@item.Title</span>
                        </div>
                        <div class="task-right">
                            <span class="badge @(item.IsDone ? "badge-done" : "badge-pending")">
                                @(item.IsDone ? "Done" : "Waiting")
                            </span>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="icon-link">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="icon-link text-danger">Delete</a>
                        </div>
                    </div>
                }
            </div>

            <p class="empty-text" id="noResults" style="display:none;">No matching tasks found.</p>
        </div>
    </div>
</div>

<script>
    const searchBox = document.getElementById('searchBox');
    const taskRows = document.querySelectorAll('.task-row');
    const noResults = document.getElementById('noResults');
    const sectionLabel = document.getElementById('sectionLabel');

    function filterTasks(mode) {
        let visibleCount = 0;
        taskRows.forEach(row => {
            const status = row.getAttribute('data-status');
            const matchesFilter = (mode === 'all') || (status === mode);
            const searchTerm = searchBox.value.toLowerCase();
            const matchesSearch = row.getAttribute('data-title').includes(searchTerm);
            if (matchesFilter && matchesSearch) {
                row.style.display = 'flex';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        sectionLabel.textContent = mode === 'all' ? 'ALL TASKS' : mode === 'done' ? 'DONE' : 'PENDING';
        document.querySelectorAll('.stat-tile').forEach(tile => tile.classList.remove('active-filter'));
        if (mode === 'all') document.getElementById('filterTotal').classList.add('active-filter');
        if (mode === 'done') document.getElementById('filterDone').classList.add('active-filter');
        if (mode === 'pending') document.getElementById('filterPending').classList.add('active-filter');
    }

    searchBox.addEventListener('input', () => {
        const activeTile = document.querySelector('.stat-tile.active-filter');
        let currentMode = 'all';
        if (activeTile && activeTile.id === 'filterDone') currentMode = 'done';
        if (activeTile && activeTile.id === 'filterPending') currentMode = 'pending';
        filterTasks(currentMode);
    });

    filterTasks('pending');
</script>