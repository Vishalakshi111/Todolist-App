@page
@model LogoutModel

@{
    ViewData["Title"] = "Log out";
}

<style>
    .auth-links {
        display: none;
    }
</style>

<div class="form-page">
    <div class="form-card" style="text-align:center;">
        <h2>Log out</h2>
        <p class="subtext">Are you sure you want to log out?</p>

        <form method="post">
            <button type="submit" class="btn-save" style="width:100%; text-align:center;">Log out</button>
        </form>
    </div>
</div>