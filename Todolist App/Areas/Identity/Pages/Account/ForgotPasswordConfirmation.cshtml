@page
@model ForgotPasswordConfirmation

@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    .auth-links {
        display: none;
    }
</style>

<div class="form-page">
    <div class="form-title">TODOLIST_APP</div>
    <div class="form-card" style="text-align:center;">
        <h2>Check your email</h2>
        <p class="subtext">Please check your email to reset your password.</p>
    </div>
</div>